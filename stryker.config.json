{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false,
    "pool": "forks"
  },
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.js",
    "!src/**/*.test.ts",
    "!src/**/*.d.ts",
    "!src/testing/**",
    "!src/vite.js",
    "!src/adapter.js",
    "!src/server/entry.ts",
    "!src/di/discovered.ts",
    "!src/di/discoveredFrontends.ts"
  ],
  "reporters": [
    "progress",
    "json",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "concurrency": "100%",
  "timeoutMS": 15000,
  "ignorePatterns": [
    "reports"
  ],
  "warnings": {
    "slow": false
  }
}
