{
  "name": "@ingeniozit/caits",
  "version": "0.4.0",
  "description": "CAITS (Clean Architecture In TypeScript): the technical base of a Marko project with a backend and a frontend.",
  "repository": "github:IngeniozIT/caits",
  "license": "0BSD",
  "private": true,
  "type": "module",
  "bin": {
    "caits": "bin/caits.js"
  },
  "exports": {
    "./vite": {
      "types": "./src/vite.types.d.ts",
      "default": "./src/vite.js"
    },
    "./quality/*": "./quality/*.mjs",
    "./*": "./src/*.ts"
  },
  "files": [
    "bin",
    "quality",
    "src",
    "template",
    "!bin/**/*.test.ts",
    "!quality/**/*.test.mjs",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run stryker.config.json",
    "test:template": "node test/template.js",
    "check": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "@marko/run": ">=0.11",
    "vite": ">=8",
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "@marko/run": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@marko/compiler": "^5.42.10",
    "@marko/run": "^0.11.13",
    "@marko/type-check": "^3.2.1",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "marko": "^6.4.0",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
