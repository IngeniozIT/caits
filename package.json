{
  "name": "@ingeniozits/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./src/vite.types.d.ts",
      "default": "./src/vite.js"
    },
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run stryker.config.json",
    "check": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "@marko/run": ">=0.11",
    "vite": ">=8",
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "@marko/run": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@marko/run": "^0.11.13",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "marko": "^6.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
